# Másold `.env` néven, ha el akarsz térni az alapértékektől. Secret IDE NEM kerül (D13):
# a secretek a secrets/ mappában élnek, lásd secrets/README.md.

# A böngészőben látott origin; a backend WebSocket-Origin-ellenőrzése ezt engedi.
PUBLIC_ORIGIN=http://localhost:8080

# A frontend-konténer (nginx) publikált címe és portja.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# A /healthz által visszaadott verzió.
APP_VERSION=dev

# Bejelentkezés (WP2). A kliens-secret NEM ide kerül: secrets/oidc_client_secret.txt (lásd README, Bejelentkezés).
# Fejlesztésben az issuer a valódi Google (D49); a kliens-azonosítót a Google Cloud Console adja.
OIDC_CLIENT_ID=
# OIDC_ISSUER=https://accounts.google.com
# Secure süti: élesben true (alapértelmezés), http://localhost-os fejlesztésben false.
# COOKIE_SECURE=false
