{
  "name": "@taltos/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@taltos/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/proxy-addr": "^5.1.2",
    "@fastify/websocket": "^11.3.4",
    "@hocuspocus/server": "^4.7.1",
    "@taltos/shared": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "fastify": "^5.12.7",
    "pg": "~8.23.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "~8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "~0.31.11",
    "libpg-query": "^18.1.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
